{
  "name": "@zenithbuild/language",
  "displayName": "Zenith Language Support",
  "description": "Syntax highlighting, snippets, and VS Code language-server integration for Zenith (.zen files)",
  "version": "0.9.2",
  "publisher": "ZenithBuild",
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:zenith",
    "onLanguage:zen",
    "onCommand:zenith.runContractPack",
    "onCommand:zenith.runLegacyTests",
    "onCommand:zenith.build",
    "onCommand:zenith.restartServer"
  ],
  "scripts": {
    "test": "node --test test/grammar-snippets.spec.js test/api-truth.spec.js test/package-client.spec.js",
    "smoke:neovim": "node scripts/neovim-installed-smoke.mjs",
    "build:server": "cd ../zenith-language-server && bun run build",
    "compile": "bun x esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node && bun x esbuild ../zenith-language-server/src/server.ts --bundle --outfile=out/server.js --platform=node --format=cjs --external:@zenithbuild/compiler",
    "watch": "bun run compile -- --watch",
    "build:markplace": "bun run build:marketplace",
    "build:marketplace": "bun run build:server && bun run compile && node scripts/build.js marketplace",
    "build:openvsx": "bun run build:server && bun run compile && node scripts/build.js openvsx",
    "build:all": "bun run build:server && bun run compile && node scripts/build.js all",
    "release": "bun run scripts/release.ts",
    "release:dry": "bun run scripts/release.ts --dry-run",
    "release:patch": "bun run scripts/release.ts --bump=patch",
    "release:minor": "bun run scripts/release.ts --bump=minor",
    "release:major": "bun run scripts/release.ts --bump=major",
    "build": "tsc",
    "verify:pack": "node scripts/assert-pack-payload.mjs",
    "prepublishOnly": "bun run build:server && bun run compile && npm test && npm run verify:pack"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.19.0",
    "typescript": "^5.0.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "icon": "assets/logo.png",
  "keywords": [
    "zenith",
    "zen",
    "syntax",
    "highlighting",
    "intellisense",
    "framework"
  ],
  "contributes": {
    "languages": [
      {
        "id": "zenith",
        "aliases": [
          "Zenith",
          "zenith"
        ],
        "extensions": [
          ".zen",
          ".zen.html",
          ".zenx"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "zen",
        "aliases": [
          "Zen (legacy alias)"
        ],
        "extensions": [],
        "configuration": "./language-configuration.json"
      }
    ],
    "snippets": [
      {
        "language": "zenith",
        "path": "./snippets/zenith.code-snippets"
      },
      {
        "language": "zen",
        "path": "./snippets/zenith.code-snippets"
      }
    ],
    "grammars": [
      {
        "language": "zenith",
        "scopeName": "text.html.zenith",
        "path": "./syntaxes/zenith.tmLanguage.json",
        "embeddedLanguages": {
          "source.js": "javascript",
          "source.ts": "typescript",
          "source.ts.embedded.zenith": "typescript",
          "source.css": "css",
          "text.html.basic": "html",
          "meta.embedded.block.javascript": "javascript",
          "meta.embedded.block.typescript": "typescript",
          "meta.embedded.block.css": "css"
        }
      },
      {
        "language": "zen",
        "scopeName": "text.html.zenith",
        "path": "./syntaxes/zenith.tmLanguage.json",
        "embeddedLanguages": {
          "source.js": "javascript",
          "source.ts": "typescript",
          "source.ts.embedded.zenith": "typescript",
          "source.css": "css",
          "text.html.basic": "html",
          "meta.embedded.block.javascript": "javascript",
          "meta.embedded.block.typescript": "typescript",
          "meta.embedded.block.css": "css"
        }
      }
    ],
    "configurationDefaults": {
      "[zenith]": {
        "editor.formatOnSave": true,
        "editor.wordBasedSuggestions": "off",
        "editor.suggest.insertMode": "replace",
        "editor.semanticHighlighting.enabled": true,
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": true
        },
        "editor.autoClosingBrackets": "always"
      },
      "[zen]": {
        "editor.formatOnSave": true,
        "editor.wordBasedSuggestions": "off",
        "editor.suggest.insertMode": "replace",
        "editor.semanticHighlighting.enabled": true,
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": true
        },
        "editor.autoClosingBrackets": "always"
      },
      "emmet.includeLanguages": {
        "zenith": "html",
        "zen": "html"
      },
      "emmet.syntaxProfiles": {
        "zenith": "html",
        "zen": "html"
      }
    },
    "commands": [
      {
        "command": "zenith.runContractPack",
        "title": "Zenith: Run Contract Pack",
        "category": "Zenith"
      },
      {
        "command": "zenith.runLegacyTests",
        "title": "Zenith: Run Legacy Tests",
        "category": "Zenith"
      },
      {
        "command": "zenith.build",
        "title": "Zenith: Build",
        "category": "Zenith"
      },
      {
        "command": "zenith.restartServer",
        "title": "Zenith: Restart Server",
        "category": "Zenith"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Zenith",
      "properties": {
        "zenith.strictDomLints": {
          "type": "boolean",
          "default": false,
          "description": "When true, ZEN-DOM-* lints (querySelector, addEventListener, etc.) are reported as errors instead of warnings."
        },
        "zenith.languageServer.path": {
          "type": "string",
          "default": "",
          "description": "Optional absolute or workspace-relative path to a custom Zenith language server entry file."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zenithbuild/zenith-language.git"
  },
  "homepage": "https://github.com/zenithbuild/zenith-language#readme",
  "bugs": {
    "url": "https://github.com/zenithbuild/zenith-language/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "after/",
    "assets/",
    "docs/",
    "filetype.lua",
    "ftdetect/",
    "icons/",
    "language-configuration.json",
    "out/",
    "plugin/",
    "scripts/neovim-installed-smoke.mjs",
    "snippets/",
    "syntax/",
    "syntaxes/"
  ],
  "license": "MIT",
  "dependencies": {
    "@zenithbuild/compiler": "^0.7.11",
    "vscode-languageclient": "^9.0.1"
  }
}
