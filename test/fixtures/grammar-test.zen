<script lang="ts">
  state count = 0;

  function increment() {
    count += 1;
  }

  function decrement() {
    count -= 1;
  }

  zenMount(() => {
    console.log('Zenith app mounted');
  });
</script>

<div class="card" disabled>
  <h1>Counter: {count}</h1>
  <button on:click={increment}>+</button>
  <button on:click={decrement}>-</button>
</div>

<Counter count={count} />

<style scoped>
  .card {
    padding: 1rem;
    border-radius: 8px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  }

  button {
    margin: 0.5rem;
    padding: 0.5rem 1rem;
  }
</style>
