{
  "State Toggle": {
    "prefix": "state toggle",
    "body": [
      "state ${1:open} = false",
      "function toggle${1/(.*)/${1:/capitalize}/}() { ${1:open} = !${1:open} }",
      "$0"
    ],
    "description": "State variable with toggle function"
  },
  "Signal Counter": {
    "prefix": "signal counter",
    "body": [
      "const ${1:count} = signal(${2:0});",
      "function increment${1/(.*)/${1:/capitalize}/}() {",
      "\t${1:count}.set(${1:count}.get() + 1);",
      "}",
      "$0"
    ],
    "description": "Canonical Zenith signal: explicit .get() / .set() API"
  },
  "Signal Read": {
    "prefix": "signal read",
    "body": [
      "${1:count}.get()$0"
    ],
    "description": "Read a Zenith signal value (canonical .get())"
  },
  "Signal Write": {
    "prefix": "signal write",
    "body": [
      "${1:count}.set(${2:nextValue})$0"
    ],
    "description": "Write a Zenith signal value (canonical .set())"
  },
  "Ref DOM": {
    "prefix": "ref dom",
    "body": [
      "const ${1:el} = ref<${2:HTMLElement}>()",
      "$0"
    ],
    "description": "Ref for DOM node"
  },
  "zenMount Cleanup": {
    "prefix": "zenMount cleanup",
    "body": [
      "zenMount((ctx) => {",
      "\t$0",
      "\tctx.cleanup(${1:disposer})",
      "})"
    ],
    "description": "zenMount with ctx.cleanup for disposers"
  },
  "zenEffect Pattern": {
    "prefix": "zenEffect pattern",
    "body": [
      "zenEffect(() => {",
      "\t$0",
      "})"
    ],
    "description": "Reactive effect"
  },
  "zenWindow": {
    "prefix": "zenWindow",
    "body": [
      "const win = zenWindow()",
      "if (!win) return",
      "$0"
    ],
    "description": "SSR-safe window access"
  },
  "zenOn Keydown Escape": {
    "prefix": "zenOn keydown escape",
    "body": [
      "const doc = zenDocument()",
      "if (!doc) return",
      "const offKey = zenOn(doc, 'keydown', (e) => {",
      "\tif (e.key === 'Escape') ${1:closeMenu}()",
      "})",
      "ctx.cleanup(offKey)",
      "$0"
    ],
    "description": "zenOn keydown with Escape handler (use inside zenMount)"
  },
  "zenResize Viewport": {
    "prefix": "zenResize viewport",
    "body": [
      "const off = zenResize(({ w, h }) => {",
      "\t$0",
      "})",
      "ctx.cleanup(off)"
    ],
    "description": "zenResize with ctx.cleanup (use inside zenMount)"
  },
  "collectRefs Links": {
    "prefix": "collectRefs links",
    "body": [
      "const nodes = collectRefs(${1:refA}, ${2:refB}, ${3:refC})",
      "$0"
    ],
    "description": "Collect multiple refs into node list"
  },
  "on:click Handler": {
    "prefix": "on:click",
    "body": [
      "on:click={${1:handler}}",
      "$0"
    ],
    "description": "Canonical event binding"
  },
  "Slot Implicit": {
    "prefix": "slot",
    "body": [
      "<slot />$0"
    ],
    "description": "Single implicit slot. Marks the position where the parent's inner markup is inlined at compile time. Zenith has no named slots and no `children` prop."
  },
  "Slot Block": {
    "prefix": "slot block",
    "body": [
      "<slot>${1:default content}</slot>$0"
    ],
    "description": "Implicit slot with a default child template, used when the parent provides no inner markup."
  },
  "Component With Slot": {
    "prefix": "component slot template",
    "body": [
      "<script lang=\"ts\">",
      "export interface Props {}",
      "</script>",
      "",
      "<${1:Card} class=\"${2:card}\">",
      "\t<slot />",
      "</${1:Card}>$0"
    ],
    "description": "Component template wrapping the implicit `<slot />`. Children inline at compile time; do not invent a `children` prop."
  },
  "Import Router Navigate": {
    "prefix": "import zenith router navigate",
    "body": [
      "import { navigate } from '@zenithbuild/router'$0"
    ],
    "description": "Programmatic navigation. Canonical module is `@zenithbuild/router`; `zenith/router` is not a real import."
  },
  "Import ZenLink": {
    "prefix": "import zenlink",
    "body": [
      "import ZenLink from '@zenithbuild/router/ZenLink.zen'$0"
    ],
    "description": "Default-import the canonical `<ZenLink>` anchor component."
  },
  "ZenLink Anchor": {
    "prefix": "zenlink",
    "body": [
      "<ZenLink href=\"${1:/path}\">${2:label}</ZenLink>$0"
    ],
    "description": "Canonical soft-nav anchor. Required prop: `href`. No `to`, `preload`, `replace`, or `children` props."
  }
}
